#!/usr/bin/env python3
"""API key 登录：读一行写进 ~/.codebuddy/wonton-user.env（0600），ACP 启动壳会加载。
空行表示清掉已存的 key。`status` 退出 0 = 存着 key。"""
import os
import shlex
import sys
from pathlib import Path

PATH = Path(os.path.expanduser("~/.codebuddy/wonton-user.env"))


def stored():
    try:
        for line in PATH.read_text().splitlines():
            if line.startswith("CODEBUDDY_API_KEY=") and line.split("=", 1)[1].strip():
                return True
    except FileNotFoundError:
        pass
    return False


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "status":
        return 0 if stored() else 1
    print("粘贴 CodeBuddy API key 后发送；发送空行清除已存的 key。", flush=True)
    key = sys.stdin.readline().strip()
    PATH.parent.mkdir(parents=True, exist_ok=True)
    if not key:
        PATH.unlink(missing_ok=True)
        print("API key 已清除")
        return 0
    temporary = PATH.with_name(PATH.name + ".tmp")
    temporary.write_text(f"CODEBUDDY_API_KEY={shlex.quote(key)}\n")
    temporary.chmod(0o600)
    os.replace(temporary, PATH)
    print("API key 已保存")
    return 0


if __name__ == "__main__":
    sys.exit(main())
