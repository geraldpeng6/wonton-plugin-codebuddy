#!/usr/bin/env python3
"""CodeBuddy 的终端登录和登录状态探针。

登录：起 `codebuddy --acp`，initialize 后发 authenticate，把 agent 推来的
`_codebuddy.ai/authUrl` 通知逐行打到 stdout；用户在任意浏览器登完后 authenticate 返回，退出 0。
状态：用 initialize + session/new 探一次账号登录态（不加载用户 key 和网关），退出 0 = 已登录。

用法：
    codebuddy-acp-client login internal|external
    codebuddy-acp-client status
"""
import json
import os
import queue
import signal
import subprocess
import sys
import threading
import time

BIN = "/data/agent/tools/codebuddy/2.181.0/bin/codebuddy"
WORKSPACE = os.environ.get("WONTON_AGENT_WORKSPACE", "/workspace")
AUTH_URL_METHOD = "_codebuddy.ai/authUrl"
LOGIN_TIMEOUT = int(os.environ.get("CODEBUDDY_LOGIN_TIMEOUT", "900"))
STATUS_TIMEOUT = 20


class Agent:
    def __init__(self):
        self.process = subprocess.Popen(
            [BIN, "--acp"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, bufsize=1,
        )
        self.messages: queue.Queue = queue.Queue()
        threading.Thread(target=self._pump_stdout, daemon=True).start()
        threading.Thread(target=self._pump_stderr, daemon=True).start()

    def _pump_stdout(self):
        for line in self.process.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                self.messages.put(json.loads(line))
            except ValueError:
                print(f"codebuddy 的非 JSON 输出：{line}", file=sys.stderr, flush=True)

    def _pump_stderr(self):
        for line in self.process.stderr:
            sys.stderr.write(line)
            sys.stderr.flush()

    def send(self, message):
        self.process.stdin.write(json.dumps(message) + "\n")
        self.process.stdin.flush()

    def request(self, request_id, method, params, deadline):
        self.send({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params})
        return self.await_response(request_id, deadline, method)

    def await_response(self, request_id, deadline, method):
        """等这个请求的应答；期间把登录链接打出来，别的通知忽略。"""
        seen_url = False
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError(f"{method} 等太久没有应答")
            try:
                message = self.messages.get(timeout=remaining)
            except queue.Empty:
                continue
            if message.get("method") == AUTH_URL_METHOD:
                url = (message.get("params") or {}).get("authUrl")
                if url and not seen_url:
                    seen_url = True
                    print(url, flush=True)
                continue
            if message.get("id") != request_id:
                continue
            if "error" in message:
                return None, message["error"]
            return message.get("result"), None

    def stop(self):
        if self.process.poll() is not None:
            return
        self.process.terminate()
        try:
            self.process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()


def initialize(agent, deadline):
    result, error = agent.request(0, "initialize", {
        "protocolVersion": 1,
        "clientCapabilities": {"fs": {"readTextFile": True, "writeTextFile": True}, "terminal": False},
    }, deadline)
    if error:
        raise RuntimeError(f"initialize 失败：{error.get('message')}")
    return result or {}


def login(method):
    deadline = time.monotonic() + LOGIN_TIMEOUT
    agent = Agent()
    try:
        methods = [item.get("id") for item in initialize(agent, deadline).get("authMethods") or []]
        if methods and method not in methods:
            print(f"agent 没有登录方式 {method}，可选：{'、'.join(str(m) for m in methods)}",
                  file=sys.stderr, flush=True)
        _, error = agent.request(1, "authenticate", {"methodId": method}, deadline)
        if error:
            print(f"登录失败：{error.get('message')}", file=sys.stderr, flush=True)
            return 1
        print("登录完成", flush=True)
        return 0
    except (TimeoutError, BrokenPipeError) as error:
        print(f"登录失败：{error}", file=sys.stderr, flush=True)
        return 1
    finally:
        agent.stop()


def status():
    """退出 0 = 账号登录还在；1 = 没登录或探不出来。"""
    deadline = time.monotonic() + STATUS_TIMEOUT
    agent = Agent()
    try:
        initialize(agent, deadline)
        _, error = agent.request(1, "session/new", {"cwd": WORKSPACE, "mcpServers": []}, deadline)
        if error:
            print(error.get("message") or "未登录", file=sys.stderr, flush=True)
            return 1
        return 0
    except (TimeoutError, BrokenPipeError) as error:
        print(str(error), file=sys.stderr, flush=True)
        return 1
    finally:
        agent.stop()


def main():
    def on_signal(signum, _frame):
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    argument = sys.argv[1] if len(sys.argv) > 1 else ""
    if argument == "status":
        return status()
    if argument == "login" and len(sys.argv) > 2:
        return login(sys.argv[2])
    print("用法：codebuddy-acp-client login internal|external | status", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
